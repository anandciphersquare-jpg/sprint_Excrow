# Copy to `.env` and fill in the values for your environment.
# `.env` is gitignored. NEVER put real credentials in this template - it is
# shared. Secrets are no longer defaulted in config/settings.py, so a blank
# required value fails immediately with a clear message.

# --- Super Admin portal ---
ADMIN_BASE_URL=https://uat.sprintnxt.in/NexGenAdminFront/#/auth/login
ADMIN_USERNAME=
ADMIN_PASSWORD=
# REQUIRED. The console routes every sign-in through #/auth/otp-verify and only
# a successful verifyOtp reaches the dashboard. UAT accepts a fixed 4-digit
# code. A blank value here now fails at the challenge with a named error.
ADMIN_PIN=
ADMIN_PIN_REQUIRED=false

# --- Partner portal ---
PARTNER_BASE_URL=https://excrow-uat.sprintnxt.in/EXcrowPartnerFrontV2/#/auth/login
PARTNER_USERNAME=
PARTNER_PASSWORD=
# UAT's fixed challenge codes. Different lengths: 4 boxes for login, 6 for a
# payout. Not secrets - environment constants.
PARTNER_LOGIN_OTP=1234
PARTNER_PAYOUT_OTP=123456
# Read the login code out of Gmail instead of using the fixed one above. Off by
# default: it costs a mailbox round-trip per sign-in and makes every partner
# login depend on a live Gmail session (python scripts/save_gmail_session.py).
# Turn it on for an environment that mails a real code.
PARTNER_OTP_FROM_MAIL=false
PARTNER_OTP_MAIL_WAIT=120

# --- Company Representative (admin stage-1 auto-fill email) ---
# Must already exist as a partner so the portal auto-fills the rest.
# Use a dedicated automation account, not a named individual's.
REPRESENTATIVE_EMAIL=

# --- Runtime ---
DEFAULT_TIMEOUT_MS=30000

# Optional: force the partner suite to verify a specific pre-existing id
# instead of the one handed over by the admin suite.
# ESCROW_ID=
