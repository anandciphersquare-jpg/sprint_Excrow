{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.78",
        "--isolated",
        "--ignore-https-errors",
        "--viewport-size",
        "1440x900",
        "--timeout-navigation",
        "30000",
        "--output-dir",
        ".playwright-mcp",
        "--save-session"
      ],
      "env": {}
    }
  }
}
